# PHP 8.2 with Apache (Render本番環境用)
FROM php:8.2-apache

# 必要なシステムパッケージをインストール
RUN apt-get update && apt-get install -y \
    libzip-dev \
    libpq-dev \
    zip \
    unzip \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 必要なPHP拡張機能をインストール（MySQL & PostgreSQL対応）
RUN docker-php-ext-install pdo pdo_mysql pdo_pgsql mysqli opcache

# OPcache設定（本番環境用パフォーマンス最適化）
RUN { \
    echo 'opcache.memory_consumption=128'; \
    echo 'opcache.interned_strings_buffer=8'; \
    echo 'opcache.max_accelerated_files=4000'; \
    echo 'opcache.revalidate_freq=2'; \
    echo 'opcache.fast_shutdown=1'; \
    echo 'opcache.enable_cli=1'; \
    } > /usr/local/etc/php/conf.d/opcache-recommended.ini

# Apacheのmod_rewriteを有効化
RUN a2enmod rewrite

# Apache設定: AllowOverrideを有効化
RUN echo '<Directory /var/www/html>\n\
    Options Indexes FollowSymLinks\n\
    AllowOverride All\n\
    Require all granted\n\
</Directory>' > /etc/apache2/conf-available/custom.conf \
    && a2enconf custom

# 作業ディレクトリを設定
WORKDIR /var/www/html

# アプリケーションファイルをコピー
COPY . /var/www/html/

# アップロードディレクトリとログディレクトリを作成
RUN mkdir -p /var/www/html/uploads /var/www/html/logs

# ディレクトリの権限を設定
RUN chmod -R 755 /var/www/html \
    && chmod 755 /var/www/html/uploads \
    && chmod 755 /var/www/html/logs \
    && chown -R www-data:www-data /var/www/html

# 本番環境用のconfig.phpを使用
RUN cp /var/www/html/config.render.php /var/www/html/config.php

# 環境変数PORTを使用（Renderが提供）
ENV PORT=80

# Apacheのポートを公開
EXPOSE ${PORT}

# Apacheの起動スクリプトを作成
RUN echo '#!/bin/bash\n\
# Renderの環境変数PORTを使用してApacheを設定\n\
if [ -n "$PORT" ]; then\n\
    sed -i "s/Listen 80/Listen $PORT/g" /etc/apache2/ports.conf\n\
    sed -i "s/:80>/:$PORT>/g" /etc/apache2/sites-available/000-default.conf\n\
fi\n\
exec apache2-foreground' > /usr/local/bin/start.sh \
    && chmod +x /usr/local/bin/start.sh

# CMD設定
CMD ["/usr/local/bin/start.sh"]
