# PHP 8.2 with Apache (Render本番環境用)
FROM php:8.2-apache

# 必要なシステムパッケージをインストール
RUN apt-get update && apt-get install -y \
    libzip-dev \
    libpq-dev \
    zip \
    unzip \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 必要なPHP拡張機能をインストール（MySQL & PostgreSQL対応）
RUN docker-php-ext-install pdo pdo_mysql pdo_pgsql mysqli opcache

# Composerをインストール
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# OPcache設定（本番環境用パフォーマンス最適化）
RUN { \
    echo 'opcache.memory_consumption=128'; \
    echo 'opcache.interned_strings_buffer=8'; \
    echo 'opcache.max_accelerated_files=4000'; \
    echo 'opcache.revalidate_freq=2'; \
    echo 'opcache.fast_shutdown=1'; \
    echo 'opcache.enable_cli=1'; \
    } > /usr/local/etc/php/conf.d/opcache-recommended.ini

# Apacheのmod_rewriteを有効化
RUN a2enmod rewrite

# Apache設定: AllowOverrideを有効化
RUN echo '<Directory /var/www/html>\n\
    Options Indexes FollowSymLinks\n\
    AllowOverride All\n\
    Require all granted\n\
</Directory>' > /etc/apache2/conf-available/custom.conf \
    && a2enconf custom

# 作業ディレクトリを設定
WORKDIR /var/www/html

# アプリケーションファイルをコピー
COPY . /var/www/html/

# Composer依存関係をインストール（vendor/ディレクトリを生成）
RUN cd /var/www/html && composer install --no-dev --optimize-autoloader --no-interaction

# アップロードディレクトリとログディレクトリを作成
RUN mkdir -p /var/www/html/uploads /var/www/html/logs

# ディレクトリの権限を設定
RUN chmod -R 755 /var/www/html \
    && chmod 755 /var/www/html/uploads \
    && chmod 755 /var/www/html/logs \
    && chown -R www-data:www-data /var/www/html

# 本番環境用のconfig.phpを使用
RUN cp /var/www/html/config.render.php /var/www/html/config.php

# 起動スクリプトをコピーして実行権限を付与
COPY start.sh /usr/local/bin/start.sh
RUN chmod +x /usr/local/bin/start.sh

# Apacheのポートを公開
EXPOSE 80

# CMD設定
CMD ["/usr/local/bin/start.sh"]
